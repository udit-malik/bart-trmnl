{% assign origin_name = "12th St. Oakland" %}
{% assign destination_name = "16th St. Mission" %}
{% assign train_b64 = "" %}
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<div class="layout layout--col gap--large">
  {% if root.schedule.request.trip %}
    {% assign trips = root.schedule.request.trip %}
    <div class="grid grid--cols-2 pt--5 gap--xsmall">
      {% for trip in trips limit:4 %}
        <div class="item bg--black rounded--medium p--2">
          <div class="content flex flex--row gap--small">
            {% if trmnl.plugin_settings.custom_fields_values.show_icons == 'true' %}
            <div class="flex flex--col gap--medium m--1 flex--center-y" style="min-width: 25px;">
              <img class="image image-stroke--small" src="data:image/svg+xml;base64,{{ train_b64 }}">
              <i class="bi bi-geo-alt-fill text--gray-40 value--xsmall"></i>
            </div>
            {% endif %}
            <div class="flex flex--col flex--left pl--2">
              {% assign heading_lower = trip.leg['@trainHeadStation'] | downcase %}
              {% if heading_lower contains 'richmond' %}{% assign abbreviation = 'RICH' %}
              {% elsif heading_lower contains 'millbrae' %}{% assign abbreviation = 'MLBR' %}
              {% elsif heading_lower contains 'dublin' %}{% assign abbreviation = 'DUBL' %}
              {% elsif heading_lower contains 'berryessa' %}{% assign abbreviation = 'BERY' %}
              {% elsif heading_lower contains 'daly' %}{% assign abbreviation = 'DALY' %}
              {% elsif heading_lower contains 'sfo' or heading_lower contains 'francisco inter' %}{% assign abbreviation = 'SFIA' %}
              {% else %}{% assign abbreviation = trip.leg['@trainHeadStation'] %}{% endif %}
              <span class="label bg--white label--large rounded--small p--1">{{ abbreviation }}</span>
              <div class="value value--small text--white">{{ trip['@origTimeMin'] }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="item">
      <div class="content layout--col gap--small">
        <div class="value value--xlarge">⚠️</div>
        <div class="label label--small">No departures available</div>
        {% if root.message.error %}<div class="label label--xsmall">{{ root.message.error.text }}</div>{% endif %}
      </div>
    </div>
  {% endif %}

  <div class="footer"><div class="divider"></div></div>
</div>
<div class="title_bar rounded bg--white" style="border: 2px solid #000">
  <img class="image image-stroke--small" src="data:image/svg+xml;base64,{{ train_b64 }}">
  <span class="title">{{ origin_name }} → {{ destination_name }}</span>
</div>
